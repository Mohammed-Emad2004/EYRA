rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // Common helpers
    // ============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated()
          && request.auth.uid == userId;
    }

    // ============================================================
    // Users
    // ============================================================

    match /users/{userId} {

      allow read: if isOwner(userId);

      allow create: if isOwner(userId)
        && request.resource.data.keys().hasAll([
          'email',
          'created_at',
          'updated_at'
        ])
        && request.resource.data.keys().hasOnly([
          'email',
          'created_at',
          'updated_at'
        ])
        && request.resource.data.email is string
        && request.resource.data.email.size() > 0
        && request.resource.data.created_at is timestamp
        && request.resource.data.updated_at is timestamp;

      allow update: if isOwner(userId)
        && request.resource.data.keys().hasOnly([
          'email',
          'created_at',
          'updated_at'
        ])
        && request.resource.data.email is string
        && request.resource.data.email.size() > 0
        && request.resource.data.created_at == resource.data.created_at
        && request.resource.data.updated_at is timestamp;

      allow delete: if isOwner(userId);


      // ==========================================================
      // User Settings
      // ==========================================================

      match /settings/{documentId} {

        allow read: if isOwner(userId);

        allow create: if isOwner(userId)
          && documentId == 'profile'
          && request.resource.data.keys().hasAll([
            'voice_alerts',
            'alert_frequency',
            'language',
            'high_contrast',
            'large_text',
            'haptic_feedback',
            'updated_at'
          ])
          && request.resource.data.keys().hasOnly([
            'voice_alerts',
            'alert_frequency',
            'language',
            'high_contrast',
            'large_text',
            'haptic_feedback',
            'updated_at'
          ])
          && request.resource.data.voice_alerts is bool
          && request.resource.data.alert_frequency in [
            'low',
            'normal',
            'high'
          ]
          && request.resource.data.language in [
            'en',
            'ar'
          ]
          && request.resource.data.high_contrast is bool
          && request.resource.data.large_text is bool
          && request.resource.data.haptic_feedback is bool
          && request.resource.data.updated_at is timestamp;

        allow update: if isOwner(userId)
          && documentId == 'profile'
          && request.resource.data.keys().hasOnly([
            'voice_alerts',
            'alert_frequency',
            'language',
            'high_contrast',
            'large_text',
            'haptic_feedback',
            'updated_at'
          ])
          && request.resource.data.voice_alerts is bool
          && request.resource.data.alert_frequency in [
            'low',
            'normal',
            'high'
          ]
          && request.resource.data.language in [
            'en',
            'ar'
          ]
          && request.resource.data.high_contrast is bool
          && request.resource.data.large_text is bool
          && request.resource.data.haptic_feedback is bool
          && request.resource.data.updated_at is timestamp;

        allow delete: if isOwner(userId);
      }


      // ==========================================================
      // Devices
      // ==========================================================

      match /devices/{deviceId} {

        allow read: if isOwner(userId);

        allow create, update: if isOwner(userId)
          && request.resource.data.keys().hasAll([
            'device_name',
            'device_key',
            'connection_status',
            'battery_percentage',
            'last_tested_at',
            'updated_at'
          ])
          && request.resource.data.keys().hasOnly([
            'device_name',
            'device_key',
            'connection_status',
            'battery_percentage',
            'last_tested_at',
            'updated_at'
          ])
          && request.resource.data.device_name is string
          && request.resource.data.device_name.size() > 0
          && request.resource.data.device_key in [
            'smart_glasses',
            'esp32_s3',
            'camera',
            'bluetooth_audio'
          ]
          && request.resource.data.connection_status in [
            'connected',
            'disconnected'
          ]
          && (
            request.resource.data.battery_percentage == null
            || (
              request.resource.data.battery_percentage is int
              && request.resource.data.battery_percentage >= 0
              && request.resource.data.battery_percentage <= 100
            )
          )
          && (
            request.resource.data.last_tested_at == null
            || request.resource.data.last_tested_at is timestamp
          )
          && request.resource.data.updated_at is timestamp;

        allow delete: if isOwner(userId);
      }


      // ==========================================================
      // Assistance Sessions
      // ==========================================================

      match /assistance_sessions/{sessionId} {

        allow read: if isOwner(userId);

        allow create: if isOwner(userId)
          && request.resource.data.keys().hasAll([
            'session_status',
            'ai_status',
            'started_at',
            'ended_at'
          ])
          && request.resource.data.keys().hasOnly([
            'session_status',
            'ai_status',
            'started_at',
            'ended_at'
          ])
          && request.resource.data.session_status in [
            'active',
            'stopped'
          ]
          && request.resource.data.ai_status in [
            'ready',
            'processing',
            'error'
          ]
          && request.resource.data.started_at is timestamp
          && (
            request.resource.data.ended_at == null
            || request.resource.data.ended_at is timestamp
          );

        allow update: if isOwner(userId)
          && request.resource.data.keys().hasOnly([
            'session_status',
            'ai_status',
            'started_at',
            'ended_at'
          ])
          && request.resource.data.session_status in [
            'active',
            'stopped'
          ]
          && request.resource.data.ai_status in [
            'ready',
            'processing',
            'error'
          ]
          && request.resource.data.started_at == resource.data.started_at
          && (
            request.resource.data.ended_at == null
            || request.resource.data.ended_at is timestamp
          );

        allow delete: if isOwner(userId);


        // ========================================================
        // Detection Logs
        // ========================================================

        match /detection_logs/{logId} {

          allow read: if isOwner(userId);

          allow create: if isOwner(userId)
            && request.resource.data.keys().hasAll([
              'detected_label',
              'spatial_direction',
              'danger_level',
              'audio_spoken_text',
              'created_at'
            ])
            && request.resource.data.keys().hasOnly([
              'detected_label',
              'spatial_direction',
              'danger_level',
              'audio_spoken_text',
              'created_at'
            ])
            && request.resource.data.detected_label is string
            && request.resource.data.detected_label.size() > 0
            && request.resource.data.spatial_direction in [
              'left',
              'center',
              'right'
            ]
            && request.resource.data.danger_level in [
              'low',
              'medium',
              'high'
            ]
            && request.resource.data.audio_spoken_text is string
            && request.resource.data.audio_spoken_text.size() > 0
            && request.resource.data.created_at is timestamp;

          allow update: if isOwner(userId)
            && request.resource.data.keys().hasOnly([
              'detected_label',
              'spatial_direction',
              'danger_level',
              'audio_spoken_text',
              'created_at'
            ])
            && request.resource.data.created_at == resource.data.created_at
            && request.resource.data.detected_label is string
            && request.resource.data.spatial_direction in [
              'left',
              'center',
              'right'
            ]
            && request.resource.data.danger_level in [
              'low',
              'medium',
              'high'
            ]
            && request.resource.data.audio_spoken_text is string;

          allow delete: if isOwner(userId);
        }


        // ========================================================
        // Developer Telemetry
        // ========================================================

        match /developer_telemetry/{telemetryId} {

          allow read: if isOwner(userId);

          allow create: if isOwner(userId)
            && request.resource.data.keys().hasAll([
              'fps',
              'inference_latency_ms',
              'cpu_usage_pct',
              'ram_usage_mb',
              'recorded_at'
            ])
            && request.resource.data.keys().hasOnly([
              'fps',
              'inference_latency_ms',
              'cpu_usage_pct',
              'ram_usage_mb',
              'recorded_at'
            ])
            && request.resource.data.fps is number
            && request.resource.data.fps >= 0
            && request.resource.data.inference_latency_ms is number
            && request.resource.data.inference_latency_ms >= 0
            && (
              request.resource.data.cpu_usage_pct == null
              || (
                request.resource.data.cpu_usage_pct is number
                && request.resource.data.cpu_usage_pct >= 0
                && request.resource.data.cpu_usage_pct <= 100
              )
            )
            && (
              request.resource.data.ram_usage_mb == null
              || (
                request.resource.data.ram_usage_mb is number
                && request.resource.data.ram_usage_mb >= 0
              )
            )
            && request.resource.data.recorded_at is timestamp;

          allow update: if isOwner(userId)
            && request.resource.data.keys().hasOnly([
              'fps',
              'inference_latency_ms',
              'cpu_usage_pct',
              'ram_usage_mb',
              'recorded_at'
            ])
            && request.resource.data.recorded_at == resource.data.recorded_at
            && request.resource.data.fps is number
            && request.resource.data.fps >= 0
            && request.resource.data.inference_latency_ms is number
            && request.resource.data.inference_latency_ms >= 0
            && (
              request.resource.data.cpu_usage_pct == null
              || (
                request.resource.data.cpu_usage_pct is number
                && request.resource.data.cpu_usage_pct >= 0
                && request.resource.data.cpu_usage_pct <= 100
              )
            )
            && (
              request.resource.data.ram_usage_mb == null
              || (
                request.resource.data.ram_usage_mb is number
                && request.resource.data.ram_usage_mb >= 0
              )
            );

          allow delete: if isOwner(userId);
        }
      }
    }

    // ============================================================
    // Deny everything else
    // ============================================================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
